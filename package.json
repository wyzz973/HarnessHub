{
  "name": "harness-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/tests/*/*.test.js",
    "catalog": "node dist/src/cli/catalog.js",
    "discover": "node dist/src/cli/discover.js",
    "probe": "node dist/src/cli/control.js probe",
    "run:harness": "node dist/src/cli/control.js run",
    "chat": "node dist/src/cli/chat.js",
    "sessions": "node dist/src/cli/sessions.js",
    "test:real:session": "pnpm build && node --test dist/tests/real/codex-session.real.js",
    "test:real:codex": "pnpm build && node --test dist/tests/real/codex-local-provider.real.js",
    "check:design": "python3 tools/check_design.py",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "web:build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "web": "node dist/src/cli/web.js",
    "check": "pnpm build && pnpm web:build && pnpm check:design && pnpm check:boundaries",
    "test:real:provider": "pnpm build && node --test dist/tests/real/provider-switch.real.js",
    "test:web": "pnpm build && pnpm web:build && node --test dist/tests/browser/web.browser.js",
    "test:real:gemini-provider": "pnpm build && node --test dist/tests/real/gemini-provider.real.js",
    "test:real:switch": "pnpm build && node --test dist/tests/real/harness-provider-switch.real.js",
    "test:real:install": "pnpm build && node --test dist/tests/real/managed-install.real.js",
    "test:real:stream": "pnpm build && node --test dist/tests/real/live-web-stream.real.js",
    "test:real:native-resume": "pnpm build && node --test dist/tests/real/native-resume.real.js",
    "test:real:native-catalog": "pnpm build && node --test dist/tests/real/native-catalog.real.js",
    "test:real:native-activity": "pnpm build && node --test dist/tests/real/native-activity.real.js",
    "test:real:native-attachments": "pnpm build && node --test dist/tests/real/native-attachments.real.js",
    "test:real:native-commands": "pnpm build && node --test dist/tests/real/native-commands.real.js",
    "test:real:native-branch": "pnpm build && node --test dist/tests/real/native-branch.real.js",
    "test:real:native-extensions": "pnpm build && node --test dist/tests/real/native-extensions.real.js",
    "test:real:native-config": "pnpm build && node --test dist/tests/real/native-config.real.js",
    "test:real:openclaw-switch": "pnpm build && node --test dist/tests/real/openclaw-skill-switch.real.js",
    "test:real:claude-mcp": "pnpm build && node --test dist/tests/real/claude-mcp.real.js",
    "test:real:native-import": "pnpm build && node --test dist/tests/real/native-import.real.js",
    "test:real:native-subagent": "pnpm build && node --test dist/tests/real/native-subagent.real.js",
    "test:real:native-question": "pnpm build && node --test dist/tests/real/native-question.real.js",
    "test:real:native-thinking": "pnpm build && node --test dist/tests/real/native-thinking.real.js",
    "test:real:native-options": "pnpm build && node --test dist/tests/real/native-options.real.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/unbzip2-stream": "1.4.3",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lobehub/icons-static-svg": "1.95.1",
    "clsx": "2.1.1",
    "json5": "2.2.3",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.4.0",
    "semver": "7.8.5",
    "shiki": "4.4.3",
    "smol-toml": "1.9.0",
    "tailwind-merge": "3.7.0",
    "tar": "7.5.22",
    "unbzip2-stream": "1.4.3",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  }
}
