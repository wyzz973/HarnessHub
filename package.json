{
  "name": "harness-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/tests/*/*.test.js",
    "catalog": "node dist/src/cli/catalog.js",
    "discover": "node dist/src/cli/discover.js",
    "probe": "node dist/src/cli/control.js probe",
    "run:harness": "node dist/src/cli/control.js run",
    "chat": "node dist/src/cli/chat.js",
    "sessions": "node dist/src/cli/sessions.js",
    "test:real:session": "pnpm build && node --test dist/tests/real/codex-session.real.js",
    "test:real:codex": "pnpm build && node --test dist/tests/real/codex-local-provider.real.js",
    "check:design": "python3 tools/check_design.py",
    "web:build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "web": "node dist/src/cli/web.js",
    "check": "pnpm build && pnpm web:build && pnpm check:design",
    "test:real:provider": "pnpm build && node --test dist/tests/real/provider-switch.real.js",
    "test:web": "pnpm build && pnpm web:build && node --test dist/tests/browser/web.browser.js",
    "test:real:gemini-provider": "pnpm build && node --test dist/tests/real/gemini-provider.real.js",
    "test:real:switch": "pnpm build && node --test dist/tests/real/harness-provider-switch.real.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  }
}
