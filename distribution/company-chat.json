    "pi": { "modelProfile": "company" },
    "mimo": { "modelProfile": "company" },
    "dsh": { "modelProfile": "company" },
    "openclaw": { "modelProfile": "company" },
    "kimi": {
      "modelProfile": "company",
      "configuration": {
        "adapter": "kimi",
        "env": { "KIMI_MODEL_MAX_CONTEXT_SIZE": "REPLACE_WITH_CONTEXT_WINDOW" }
